# The host-vm guest kernel, aarch64 (workspace-isolation-architecture.md §5.1).
#
# A fragment for `make allnoconfig KCONFIG_ALLCONFIG=<this file>`: every option starts off, and
# only what is listed here (plus what it selects) is built in. build-kernel.sh fails if Kconfig
# drops any line below, so the list is the whole truth about the kernel. No modules and no
# initramfs: Cloud Hypervisor boots the arm64 `Image` straight into
# `sealantd` on the read-only base disk.
#
# Shared with the x86_64 fragment from "Common" down; keep the two in step.

# --- Architecture and platform (aarch64 only) ---
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_ARM64_4K_PAGES=y
# The guest boots from the device tree Cloud Hypervisor writes (arm64 ACPI needs EFI). Its power
# button is a PL061 GPIO line, read as a key by gpio-keys.
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
# Cloud Hypervisor's PCI root is a generic ECAM host bridge; MSI-X goes through the GICv3 ITS.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_ARM_GIC_V3_ITS=y
# The PL031 RTC sets the wall clock at boot (aarch64 has no kvmclock): TLS verification needs it.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_PL031=y
# Serial console for debugging (`console=ttyAMA0`, `--serial tty`).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# Virtio console for Apple Virtualization.framework (`console=hvc0`).
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO_CONSOLE=y

# --- Common ---
# CONFIG_MODULES is not set
# CONFIG_BLK_DEV_INITRD is not set
CONFIG_LOCALVERSION="-sealant-microvm"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_HIGH_RES_TIMERS=y
# A tickless idle: an idle VM costs the host no timer interrupts.
CONFIG_NO_HZ_IDLE=y
# Free page reporting returns whole pages; compaction makes them.
CONFIG_COMPACTION=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FHANDLE=y
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# Multi-arch `docker buildx` (qemu-user via binfmt_misc).
CONFIG_BINFMT_MISC=y

# The power button (ACPI on x86_64, a GPIO key on aarch64), delivered to `sealantd` as an input
# event: the runner's graceful stop.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# Filesystems: ext4 for both disks, overlayfs for the root, tmpfs/devtmpfs for /run, /tmp, /dev.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

# virtio devices Cloud Hypervisor gives the guest. virtio_blk negotiates discard, so deleting files
# on /dev/vdb punches holes in the sparse data.img.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# cgroup v2 and namespaces (guest dockerd, sealantd's own process control).
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Networking: eth0 plus what guest dockerd builds (bridge, veth, NAT through nftables or
# iptables-nft). Raw UDP is not routed off the VM in v1, so there is no WireGuard.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
# CONFIG_WIREGUARD is not set
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
# iptables' raw table, which dockerd uses through iptables-legacy.
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
